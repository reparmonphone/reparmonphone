# Copie ce fichier en .env.migration (à la racine du projet, à côté de .env)
# et remplis les valeurs ci-dessous. Ce fichier ne doit JAMAIS être commité sur Git
# (ajoute-le à .gitignore si ce n'est pas déjà le cas via .env*).

# ---------- Accès FTP à l'ancien hébergement OVH ----------
FTP_HOST=ftp.cluster011.hosting.ovh.net
FTP_USER=golfedetws
FTP_PASSWORD=colle_ton_mot_de_passe_ici

# Chemin FTP vers le dossier wp-content/uploads sur le serveur OVH.
# Vérifié dans FileZilla pour ce compte : /repar/wp-content/uploads
WP_UPLOADS_FTP_PATH=/repar/wp-content/uploads

# ---------- Supabase ----------
# Réutilise les mêmes valeurs que ton .env principal.
# ATTENTION : SUPABASE_SERVICE_ROLE_KEY est une clé à privilèges complets,
# ne jamais l'exposer côté client ni la commiter sur Git.
NEXT_PUBLIC_SUPABASE_URL=https://bjfmbrexkkpgwufdqkoy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=colle_ta_clé_service_role_ici
SUPABASE_BUCKET=products
