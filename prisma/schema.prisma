// Schéma Prisma — ReparMonPhone Next.js
// Base : PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Catalogue ----------

model Brand {
  id     String        @id @default(cuid())
  name   String        @unique // Apple, Samsung, Xiaomi, Huawei...
  slug   String        @unique
  lines  ProductLine[]

  @@map("brands")
}

// Gamme au sein d'une marque, ex: Apple -> iPhone / iPad / Apple Watch / AirPods
// Samsung -> Galaxy S / Galaxy A / Galaxy Note / Galaxy Z Flip...
model ProductLine {
  id        String  @id @default(cuid())
  name      String // "iPhone", "Galaxy S", "Redmi Note"...
  slug      String
  imageUrl  String? // image de la carte catégorie affichée sur /marque/[marque] — remplace, quand définie,
  // l'image scrappée statique de data/category_content.json (voir src/lib/categoryContent.ts)
  hubImageUrl String? // image alternative, optionnelle, utilisée UNIQUEMENT quand cette gamme apparaît une
  // deuxième fois ailleurs sur le site (ex: la gamme "iPad" est à la fois une carte sur /marque/apple ET
  // une des 4 sous-catégories affichées sur /marque/apple/ipads, voir IPAD_HUB_SLUGS dans
  // src/app/marque/[...slug]/page.tsx). Laissée vide (null), la même `imageUrl` sert partout comme avant.
  sortOrder Int     @default(0) // ordre d'affichage manuel des cartes gamme sur /marque/[marque]
  // (du plus petit au plus grand) — modifiable depuis /admin/gammes en glissant-déposant les lignes.
  // Initialisé une fois par scripts/seed-line-sort-order.js, puis entièrement sous le contrôle de
  // l'utilisateur ensuite (même logique que Model.sortOrder ci-dessous).
  brandId String
  brand   Brand   @relation(fields: [brandId], references: [id])
  models  Model[]

  @@unique([brandId, slug])
  @@map("product_lines")
}

model Model {
  id            String      @id @default(cuid())
  name          String // ex: "iPhone 16 Pro Max"
  slug          String
  imageUrl      String? // photo de la carte modèle affichée sur /marque/[marque]/[gamme] — remplace,
  // quand définie, l'image scrappée statique ou la photo produit utilisée par défaut
  // (voir src/app/marque/[...slug]/page.tsx)
  sortOrder     Int         @default(0) // ordre d'affichage manuel des cartes modèle sur /marque/[marque]/[gamme]
  // (du plus petit au plus grand) — modifiable depuis /admin/gammes en glissant-déposant les lignes.
  // Initialisé une fois par scripts/seed-model-sort-order.js (du plus récent au plus ancien),
  // puis entièrement sous le contrôle de l'utilisateur ensuite.
  featuredOnHome Boolean    @default(false) // inclut ce modèle dans le tirage aléatoire "Vedette" de la
  // page d'accueil (voir TopProduitsSection.tsx) — réglable depuis /admin/gammes (case ⭐ par modèle).
  // Tant qu'aucun modèle d'aucune gamme n'est coché, la page d'accueil garde son ancien comportement
  // (tirage dans tout le catalogue) — voir la logique de repli dans TopProduitsSection.tsx.
  productLineId String
  productLine   ProductLine @relation(fields: [productLineId], references: [id])
  products      Product[]
  repairGuides  RepairGuide[]
  @@unique([productLineId, slug])
  @@map("models")
}

enum PieceType {
  ECRAN
  BATTERIE
  NAPPE_CONNECTEUR
  CAMERA
  VITRE_ARRIERE
  CHASSIS
  HAUT_PARLEUR
  VIBREUR
  BOUTON
  OUTILLAGE
  ACCESSOIRE
  AUTRE
}

model Product {
  id                String    @id @default(cuid())
  wpId              String?   @unique // ancien ID WooCommerce, pour traçabilité migration
  title             String
  slug              String    @unique
  shortDescription  String?   @db.Text // résumé affiché sous le bouton "Ajouter au panier"
  description       String?   @db.Text // description longue (HTML), affichée pleine largeur sous la fiche produit
  metaTitle         String? // balise <title> SEO (si vide, on retombe sur le titre produit)
  metaDescription   String?   @db.Text // meta description SEO
  price             Decimal   @db.Decimal(10, 2)
  regularPrice      Decimal?  @db.Decimal(10, 2)
  pieceType         PieceType @default(AUTRE)
  condition         String? // "Neuf", "Occasion"...
  quality           String? // "Origine", "Compatible"...
  inStock           Boolean   @default(true)
  stockQty          Int?
  imageUrl          String? // image principale (compat / affichage carte produit)
  images            String[] @default([]) // galerie complète
  showInBoutique    Boolean   @default(true) // décoche pour un produit qui n'a rien à faire dans "Pièces détachées"
  // (ex: téléphone reconditionné entier) — reste visible via sa fiche directe et ses collections

  modelId String
  model   Model  @relation(fields: [modelId], references: [id])

  orderItems OrderItem[]
  reviews    ProductReview[]
  favorites  Favorite[]
  stockNotifications StockNotification[]

  // Champs mis en cache pour affichage rapide (étiquettes produit, listes) sans recalculer à chaque fois
  avgRating   Float? // ex: 4.8
  reviewCount Int    @default(0)

  // ---------- Suivi fournisseur (pieces2mobile.com) ----------
  // Référence catalogue du fournisseur (colonne "Reference_SKU" de son export CSV), retrouvée une
  // fois par correspondance de titre (voir scripts/lib/matchSupplier.js) puis figée : sert de clé de
  // jointure rapide et fiable pour scripts/weekly-fournisseur-check.js, semaine après semaine.
  supplierSku            String?
  // Dernier prix TTC connu chez le fournisseur pour ce SKU — sert de référence pour détecter une
  // hausse/baisse à la prochaine vérification hebdomadaire (voir scripts/weekly-fournisseur-check.js
  // et /admin/fournisseur). Mis à jour à CHAQUE vérification, que le prix public ait changé ou non.
  supplierPrice          Decimal?  @db.Decimal(10, 2)
  supplierPriceCheckedAt DateTime?

  supplierCheckItems SupplierCheckItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modelId])
  @@index([pieceType])
  @@index([supplierSku])
  @@map("products")
}

// ---------- Vérification hebdomadaire fournisseur (pieces2mobile.com) ----------
// Krys récupère chaque semaine un export CSV du catalogue fournisseur (titre, référence, prix,
// disponibilité) et lance scripts/weekly-fournisseur-check.js dessus. Le script compare chaque
// produit rattaché (via Product.supplierSku) au prix/stock connu la fois précédente, et :
//   - corrige IMMÉDIATEMENT le stock (rupture ↔ en stock) s'il a changé chez le fournisseur ;
//   - corrige IMMÉDIATEMENT le prix public si le fournisseur a AUGMENTÉ son prix (même montant en €) ;
//   - NE TOUCHE PAS au prix public si le fournisseur a BAISSÉ son prix — c'est à Krys de décider
//     depuis /admin/fournisseur (voir SupplierCheckItem.reviewed).
// Chaque exécution crée un SupplierCheckRun avec le détail des changements (SupplierCheckItem), pour
// que /admin/fournisseur puisse afficher "qu'est-ce qui a changé cette semaine".

enum SupplierCheckItemType {
  PRIX_BAISSE   // le fournisseur a baissé son prix — prix public inchangé, en attente de décision
  PRIX_HAUSSE   // le fournisseur a augmenté son prix — prix public déjà corrigé du même montant
  RETOUR_STOCK  // redevenu disponible chez le fournisseur — stock déjà remis à "en stock"
  RUPTURE_STOCK // passé en rupture chez le fournisseur — stock déjà remis à "rupture"
}

model SupplierCheckRun {
  id            String   @id @default(cuid())
  sourceFile    String? // nom du fichier CSV fournisseur utilisé pour cette vérification
  totalCompared Int      @default(0) // nb de produits rapprochés d'une fiche fournisseur ce run-là
  newlyMatched  Int      @default(0) // nb de produits pour lesquels un SKU fournisseur a été trouvé pour la première fois
  createdAt     DateTime @default(now())

  items SupplierCheckItem[]

  @@map("supplier_check_runs")
}

model SupplierCheckItem {
  id      String                @id @default(cuid())
  runId   String
  run     SupplierCheckRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId String
  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type    SupplierCheckItemType

  // Prix PUBLIC (ce que voit le client) avant/après ce run — identiques pour PRIX_BAISSE (non touché)
  oldPrice Decimal? @db.Decimal(10, 2)
  newPrice Decimal? @db.Decimal(10, 2)

  // Prix FOURNISSEUR avant/après (ce qui a déclenché l'écart)
  oldSupplierPrice Decimal? @db.Decimal(10, 2)
  newSupplierPrice Decimal? @db.Decimal(10, 2)

  oldStock Boolean?
  newStock Boolean?

  applied  Boolean @default(false) // true = correction déjà appliquée en base (toujours le cas sauf PRIX_BAISSE)
  // Pour un PRIX_BAISSE uniquement : Krys a traité la ligne depuis /admin/fournisseur (appliqué la
  // baisse ou choisi de garder son prix actuel). Les autres types n'ont rien à traiter, donc restent
  // à true par défaut (voir défaut ci-dessous appliqué côté script).
  reviewed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([productId])
  @@index([type, reviewed])
  @@map("supplier_check_items")
}

// ---------- Alerte "de retour en stock" ----------
// Un client (connecté ou non) s'inscrit sur la fiche d'un produit en rupture pour être prévenu par
// email dès qu'il redevient disponible. Sert aussi côté admin (page /admin/alertes-stock) à savoir
// quels produits en rupture intéressent le plus de monde, pour prioriser les réappros fournisseur.
model StockNotification {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String
  userId     String?   // uuid Supabase Auth si le client était connecté au moment de l'inscription
  notifiedAt DateTime? // renseigné dès que l'email "de retour en stock" a été envoyé (un seul envoi
  // par inscription — si le client se réinscrit après coup, ce champ est remis à zéro, voir
  // src/app/api/stock-notifications/route.ts)
  createdAt  DateTime  @default(now())

  @@unique([productId, email])
  @@index([productId])
  @@map("stock_notifications")
}

// ---------- Avis produits (différents des avis Google/Facebook de l'entreprise) ----------

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String? // uuid Supabase Auth si laissé par un client connecté
  authorName String
  rating     Int // 1 à 5
  text       String?  @db.Text
  verified   Boolean  @default(false) // true = achat confirmé (via l'historique de commandes)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@map("product_reviews")
}

// ---------- Commandes / e-commerce ----------

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  SUMUP
  PAYPAL
}

enum ShippingCarrier {
  CHRONOPOST
  COLISSIMO
  MONDIAL_RELAY
  RELAIS_COLIS
  AUTRE
}

model Order {
  id             String      @id @default(cuid())
  invoiceNumber  Int         @unique @default(autoincrement())
  userId         String? // uuid Supabase Auth (auth.users.id) si le client était connecté au moment de la commande
  customerName   String
  customerEmail  String
  customerPhone  String?
  companyName    String? // facultatif, saisi sur l'adresse de facturation
  shippingLine1  String
  shippingCity   String
  shippingZip    String

  // Adresse de facturation (peut différer de la livraison — choix géré nativement par Stripe Checkout)
  billingName    String?
  billingLine1   String?
  billingCity    String?
  billingZip     String?

  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  promoCode      String?
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  shippingCost   Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)

  paymentProvider PaymentProvider @default(STRIPE)
  stripeSessionId String?    @unique
  stripePaymentIntentId String?
  sumupCheckoutId String?    @unique
  paypalOrderId  String?     @unique

  // Mode de paiement (renseigné automatiquement par le webhook après paiement)
  paymentBrand   String? // ex: "visa", "mastercard"...
  paymentLast4   String?

  // Suivi de livraison
  carrier         ShippingCarrier?
  trackingNumber  String?
  trackingUrlOverride String?

  reminderSentAt DateTime? // dernière relance email envoyée pour une commande restée "En attente"
  deliveredAt    DateTime? // date à laquelle la commande est passée au statut "Livrée"
  reviewReminderSentAt DateTime? // relance "laisse un avis" déjà envoyée pour cette commande

  // Coût réel d'expédition payé par l'admin (Chronopost/Colissimo...) — DIFFÉRENT de shippingCost
  // (ce que le CLIENT a payé). Saisi manuellement par l'admin pour le calcul du bénéfice, jamais
  // montré au client. Null tant que non renseigné.
  actualShippingCost Decimal? @db.Decimal(10, 2)

  items  OrderItem[]
  claims Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  // Prix d'achat réellement payé au fournisseur pour CETTE commande (prix pro, peut varier d'une
  // commande à l'autre) — saisi manuellement par l'admin, jamais montré au client, utilisé uniquement
  // pour calculer le bénéfice (page /admin/benefice). Null tant que non renseigné.
  costPrice Decimal? @db.Decimal(10, 2)

  @@map("order_items")
}

// ---------- Litiges / réclamations clients ----------
// Un litige est toujours rattaché à une commande. Le client décrit le problème et peut joindre
// une photo (stockée sur Supabase, comme le reste des images du site). L'admin traite ensuite
// le litige en accordant soit un avoir (code promo généré automatiquement, montant fixe, usage
// unique), soit un vrai remboursement (fait manuellement par l'admin directement dans le
// dashboard Stripe/SumUp/PayPal — voir lien direct sur la page détail admin).

enum ClaimStatus {
  OPEN            // en attente de traitement
  CREDIT_ISSUED   // avoir accordé (code promo généré et envoyé)
  REFUNDED        // remboursement réel effectué (marqué manuellement par l'admin)
  REJECTED        // réclamation refusée
}

model Claim {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  customerEmail String
  description   String      @db.Text
  photoUrl      String?

  status        ClaimStatus @default(OPEN)
  adminNote     String?     @db.Text

  // Renseigné automatiquement si un avoir est accordé
  creditCode    String?
  creditAmount  Decimal?    @db.Decimal(10, 2)

  createdAt     DateTime    @default(now())
  resolvedAt    DateTime?

  @@index([orderId])
  @@map("claims")
}

// ---------- Prise de RDV réparation ----------

enum AppointmentType {
  ATELIER
  DOMICILE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DONE
  CANCELLED
}

model Appointment {
  id              String            @id @default(cuid())
  userId          String? // uuid Supabase Auth (auth.users.id) si le client était connecté au moment de la demande
  customerName    String
  customerEmail   String
  customerPhone   String
  deviceBrand     String
  deviceModel     String
  issueDescription String           @db.Text
  type            AppointmentType   @default(ATELIER)
  city            String // pour calcul du supplément zone
  extraFee        Decimal           @default(0) @db.Decimal(10, 2)
  latitude   Float?
  longitude  Float?
  preferredDate   DateTime
  status          AppointmentStatus @default(REQUESTED)
  adminReply    String?   @db.Text // dernière réponse envoyée au client depuis l'admin
  repliedAt     DateTime? // date d'envoi de cette réponse

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("appointments")
}

// ---------- Réparation par correspondance (envoi postal) ----------
// Le client envoie son appareil par Chronopost, Krys diagnostique et répare, puis ne renvoie
// l'appareil qu'une fois le paiement reçu (voir sendMailInRepairPaymentLink côté admin) — le prix
// envoyé au client inclut toujours les frais de renvoi Chronopost, jamais facturés séparément.

enum MailInRepairQuoteDecision {
  ACCEPTED
  DECLINED
}

enum MailInRepairStatus {
  REQUESTED        // demande reçue, en attente de réponse
  AWAITING_DEVICE  // réponse/estimation envoyée, on attend que le client envoie l'appareil
  DEVICE_RECEIVED  // appareil reçu à l'atelier
  AWAITING_PAYMENT // diagnostic fait, lien de paiement envoyé au client
  PAID             // payé — réparation en cours ou terminée, prête à être renvoyée
  SHIPPED_BACK     // renvoyé au client (voir outboundTrackingNumber)
  CANCELLED
}

model MailInRepair {
  id               String             @id @default(cuid())
  userId           String? // uuid Supabase Auth si le client était connecté au moment de la demande
  customerName     String
  customerEmail    String
  customerPhone    String
  deviceBrand      String
  deviceModel      String
  issueDescription String             @db.Text
  clientPhotos     String[]           @default([]) // photos de l'état de l'appareil jointes par le CLIENT à la demande initiale

  status           MailInRepairStatus @default(REQUESTED)

  adminReply       String?            @db.Text // dernière réponse libre envoyée au client (mise en cache — l'historique complet est dans `replies`)
  repliedAt        DateTime?
  replies          MailInRepairReply[] // historique complet des messages envoyés au client (un message peut inclure un devis, voir quotedEstimate)

  // Décision du client sur le DERNIER devis envoyé (celui de replies dont quotedEstimate n'est pas
  // null) — réinitialisée à null à chaque nouveau devis envoyé, tant que le client n'a pas répondu.
  quoteDecision    MailInRepairQuoteDecision?
  quoteDecisionAt  DateTime?

  quotedPrice      Decimal?           @db.Decimal(10, 2) // prix final confirmé après diagnostic (pièce + main d'œuvre + renvoi Chronopost inclus)
  stripeSessionId  String?            @unique
  stripePaymentIntentId String?
  paidAt           DateTime?

  inboundCarrier         ShippingCarrier? // transporteur choisi par le CLIENT pour l'envoi vers l'atelier (Chronopost ou Colissimo recommandé)
  inboundTrackingNumber  String? // suivi utilisé par le CLIENT pour nous envoyer l'appareil (facultatif, saisi par le client ou l'admin)
  outboundCarrier        ShippingCarrier @default(CHRONOPOST)
  outboundTrackingNumber String? // suivi du RENVOI, une fois payé et réparé
  repairedPhotos          String[]        @default([]) // photos de l'appareil RÉPARÉ ajoutées par l'ADMIN avant renvoi — visibles du client

  adminNote        String?            @db.Text // note interne, jamais visible du client

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("mail_in_repairs")
}

// Historique des messages envoyés au client pour une demande de réparation par correspondance — avant
// ce modèle, chaque nouvelle réponse écrasait la précédente (un seul champ `adminReply`), donc les
// messages précédents disparaissaient. Un message avec quotedEstimate renseigné est un DEVIS : le
// client doit l'accepter ou le refuser (voir MailInRepair.quoteDecision) avant de pouvoir envoyer son
// appareil, sauf si aucun devis n'a jamais été envoyé sur la demande (flux inchangé dans ce cas).
model MailInRepairReply {
  id             String       @id @default(cuid())
  mailInRepairId String
  mailInRepair   MailInRepair @relation(fields: [mailInRepairId], references: [id], onDelete: Cascade)
  message        String       @db.Text
  quotedEstimate Decimal?     @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())

  @@index([mailInRepairId])
  @@map("mail_in_repair_replies")
}

// ---------- Zones de livraison / déplacement à supplément ----------
// Sainte-Maxime = zone de base (gratuit)
// Saint-Tropez, Grimaud, Cogolin, La Croix-Valmer, Gassin, Plan-de-la-Tour, Les Issambres = +30€

model ServiceZone {
  id        String  @id @default(cuid())
  cityName  String  @unique
  extraFee  Decimal @default(0) @db.Decimal(10, 2)

  @@map("service_zones")
}

// ---------- Formulaire de contact ----------

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  requestType String? // "Aide" / "Bug" / "Erreur" / "Demande directe" (widget flottant "Besoin d'aide ?")
  subject     String
  message     String   @db.Text
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ---------- Avis clients (gérés manuellement en admin, faute d'intégration API live) ----------

enum ReviewSource {
  GOOGLE
  FACEBOOK
}

model Review {
  id             String       @id @default(cuid())
  source         ReviewSource
  authorName     String
  authorPhotoUrl String? // photo de l'auteur (facultatif, sinon initiales générées)
  rating         Int? // 1-5, optionnel (Facebook n'a que "recommande" sans note chiffrée)
  text           String       @db.Text
  reviewDate     DateTime? // date réelle de l'avis, pour afficher "il y a X jours"
  verified       Boolean      @default(true)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())

  @@map("reviews")
}

// ---------- Partenaires & liens de référencement (page d'accueil, gérés en admin) ----------

model Partner {
  id       String  @id @default(cuid())
  name     String
  logoUrl  String?
  linkUrl  String
  order    Int     @default(0)

  @@map("partners")
}

model ReferralLink {
  id       String @id @default(cuid())
  label    String
  url      String
  order    Int    @default(0)

  @@map("referral_links")
}

// ---------- Frais de port / options de livraison (configurables en admin) ----------

model ShippingOption {
  id          String   @id @default(cuid())
  label       String
  description String? // ex: "Livraison en 24h"
  price       Decimal  @db.Decimal(10, 2) // tarif par défaut = France métropolitaine
  order       Int      @default(0)
  active      Boolean  @default(true)
  // Disponibilité par destination : par défaut une option est proposée partout (France métropolitaine +
  // toutes les zones existantes, voir ShippingOptionZone plus bas). Décoche "France métropolitaine" pour
  // une option qui n'a de sens que pour l'Outre-mer (ex: un transporteur différent), et/ou décoche une
  // zone précise depuis /admin/livraison si cette option ne doit pas y être proposée.
  availableMetropole Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zoneRates ShippingZoneRate[]
  zoneLinks ShippingOptionZone[]

  @@map("shipping_options")
}

// ---------- Zones de livraison à tarif différent (Outre-mer, etc.) ----------
// Le tarif "de base" d'une ShippingOption (ci-dessus) s'applique à la France métropolitaine par
// défaut. Une ShippingZone regroupe des destinations identifiées par leurs préfixes de code postal
// (ex: "973" = Guyane) qui doivent avoir un tarif différent — un ShippingZoneRate donne alors le prix
// spécifique pour une (option de livraison × zone) donnée. Si aucun ShippingZoneRate n'existe pour une
// zone donnée, le prix de base de la ShippingOption s'applique (comportement inchangé, rétrocompatible).
model ShippingZone {
  id             String   @id @default(cuid())
  name           String // ex: "Outre-mer (Guadeloupe, Martinique, Guyane, Réunion, Mayotte...)"
  // Préfixes de code postal identifiant cette zone, ex: ["971","972","973","974","976"].
  // Détection : on prend les 3 premiers chiffres du code postal saisi par le client et on cherche
  // une zone dont un des préfixes correspond (voir src/lib/shippingZones.ts).
  postalPrefixes String[] @default([])
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rates       ShippingZoneRate[]
  optionLinks ShippingOptionZone[]

  @@map("shipping_zones")
}

model ShippingZoneRate {
  id               String         @id @default(cuid())
  shippingOptionId String
  shippingOption   ShippingOption @relation(fields: [shippingOptionId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  price            Decimal        @db.Decimal(10, 2)

  @@unique([shippingOptionId, zoneId])
  @@map("shipping_zone_rates")
}

// ---------- Disponibilité d'une option de livraison par zone ----------
// Une ligne ici = "cette ShippingOption est proposée aux clients de cette ShippingZone". Une option
// sans aucune ligne pour une zone donnée n'est simplement pas proposée aux clients de cette zone (elle
// reste proposée à la France métropolitaine si availableMetropole = true, et inversement). Par défaut,
// à la création d'une option ou d'une zone, on crée automatiquement toutes les lignes correspondantes
// (comportement "disponible partout" par défaut) — Krys peut ensuite décocher au cas par cas depuis
// /admin/livraison, par exemple pour un transporteur Outre-mer qui n'a pas de sens pour la France.
model ShippingOptionZone {
  id               String         @id @default(cuid())
  shippingOptionId String
  shippingOption   ShippingOption @relation(fields: [shippingOptionId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([shippingOptionId, zoneId])
  @@map("shipping_option_zones")
}

// ---------- Réglages divers (clé/valeur), pour des petites infos éditables sans créer une table dédiée ----------

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ---------- Redirections 301 (crucial après une migration de site, pour ne pas perdre le référencement accumulé) ----------

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique // ex: "/ancienne-url-woocommerce" (commence toujours par /)
  toPath     String // ex: "/produit/nouvelle-url"
  statusCode Int      @default(301)
  hits       Int      @default(0) // nombre de fois où la redirection a été utilisée
  createdAt  DateTime @default(now())

  @@map("redirects")
}

// ---------- Statistiques de visite (compteur page d'accueil + tableau de bord admin) ----------

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@map("page_views")
}

// ---------- Codes promo ----------

enum PromoType {
  PERCENT
  FIXED
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      PromoType
  value     Decimal   @db.Decimal(10, 2) // ex: 10 (%) si PERCENT, ou 5.00 (€) si FIXED
  active    Boolean   @default(true)
  expiresAt DateTime?
  maxUses   Int? // null = illimité
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("promo_codes")
}

// ---------- Pages de contenu éditables (À propos, Mentions légales, CGV...) ----------

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique // ex: "a-propos", "mentions-legales", "cgv"...
  title       String
  contentHtml String   @db.Text
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

// ---------- Liens de menu personnalisés (header) ----------
// Les marques (Apple/Samsung/...) sont toujours générées automatiquement depuis le catalogue.
// Ces entrées viennent s'ajouter après, dans l'ordre choisi (ex: "Prendre RDV", "Blog", "Promos"...).

model HeaderMenuItem {
  id          String   @id @default(cuid())
  label       String
  href        String
  order       Int      @default(0)
  openInNewTab Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("header_menu_items")
}

// ---------- Collections manuelles (ex: "Apple Reconditionnés") ----------
// Regroupe des MODÈLES choisis à la main, indépendamment de leur marque/gamme d'origine.
// Utile pour des pages transversales du style "Reconditionnés", "Promo été", etc.
// Se lie ensuite à une entrée du menu header via son URL /collection/[slug].

model Collection {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  productIds String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("collections")
}

// ---------- Favoris clients ----------
// Un produit peut être mis en favori par un client connecté (userId = uuid Supabase Auth).
// Contrainte unique (userId, productId) pour éviter les doublons — le "toggle" gère l'ajout/suppression.

model Favorite {
  id        String   @id @default(cuid())
  userId    String // uuid Supabase Auth (auth.users.id)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

// ---------- Guides de réparation (blog type iFixit) ----------
// Un guide est optionnellement lié à un Model existant du catalogue (même table que les produits) :
// ça permet d'afficher automatiquement "Guides pour ce modèle" sur une fiche produit, sans avoir
// à faire de liaison manuelle produit <-> guide.

enum GuideDifficulty {
  FACILE
  MOYEN
  DIFFICILE
}

model RepairGuide {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  excerpt         String?         @db.Text // résumé affiché sur les cartes/listes
  coverImageUrl   String?

  modelId         String? // lien vers le modèle concerné (ex: "iPhone 14") — active la correspondance auto avec les produits
  model           Model?          @relation(fields: [modelId], references: [id])

  difficulty      GuideDifficulty @default(MOYEN)
  estimatedTime   String? // ex: "30-45 min"
  toolsNeeded     String[]        @default([]) // ex: ["Tournevis Pentalobe P2", "Ventouse"]
  partsNeeded     String[]        @default([]) // ex: ["Écran de remplacement iPhone 14"]

  published       Boolean         @default(true)
  viewCount       Int             @default(0)

  metaTitle       String?
  metaDescription String?         @db.Text

  steps           GuideStep[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([modelId])
  @@map("repair_guides")
}

model GuideStep {
  id          String      @id @default(cuid())
  guideId     String
  guide       RepairGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  contentHtml String      @db.Text
  imageUrl    String?
  warning     String?     @db.Text // avertissement optionnel affiché en encart rouge (ex: "Attention à la nappe")

  @@index([guideId])
  @@map("guide_steps")
}
