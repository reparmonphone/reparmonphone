// SchÃ©ma Prisma â€” ReparMonPhone Next.js
// Base : PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Catalogue ----------

model Brand {
  id     String        @id @default(cuid())
  name   String        @unique // Apple, Samsung, Xiaomi, Huawei...
  slug   String        @unique
  lines  ProductLine[]

  @@map("brands")
}

// Gamme au sein d'une marque, ex: Apple -> iPhone / iPad / Apple Watch / AirPods
// Samsung -> Galaxy S / Galaxy A / Galaxy Note / Galaxy Z Flip...
model ProductLine {
  id      String  @id @default(cuid())
  name    String // "iPhone", "Galaxy S", "Redmi Note"...
  slug    String
  brandId String
  brand   Brand   @relation(fields: [brandId], references: [id])
  models  Model[]

  @@unique([brandId, slug])
  @@map("product_lines")
}

model Model {
  id            String      @id @default(cuid())
  name          String // ex: "iPhone 16 Pro Max"
  slug          String
  productLineId String
  productLine   ProductLine @relation(fields: [productLineId], references: [id])
  products      Product[]
  repairGuides  RepairGuide[]   // ← ligne à ajouter
  @@unique([productLineId, slug])
  @@map("models")
}

enum PieceType {
  ECRAN
  BATTERIE
  NAPPE_CONNECTEUR
  CAMERA
  VITRE_ARRIERE
  CHASSIS
  HAUT_PARLEUR
  VIBREUR
  BOUTON
  OUTILLAGE
  ACCESSOIRE
  AUTRE
}

model Product {
  id                String    @id @default(cuid())
  wpId              String?   @unique // ancien ID WooCommerce, pour traÃ§abilitÃ© migration
  title             String
  slug              String    @unique
  shortDescription  String?   @db.Text // rÃ©sumÃ© affichÃ© sous le bouton "Ajouter au panier"
  description       String?   @db.Text // description longue (HTML), affichÃ©e pleine largeur sous la fiche produit
  metaTitle         String? // balise <title> SEO (si vide, on retombe sur le titre produit)
  metaDescription   String?   @db.Text // meta description SEO
  price             Decimal   @db.Decimal(10, 2)
  regularPrice      Decimal?  @db.Decimal(10, 2)
  pieceType         PieceType @default(AUTRE)
  condition         String? // "Neuf", "Occasion"...
  quality           String? // "Origine", "Compatible"...
  inStock           Boolean   @default(true)
  stockQty          Int?
  imageUrl          String? // image principale (compat / affichage carte produit)
  images            String[] @default([]) // galerie complÃ¨te
  showInBoutique    Boolean   @default(true) // dÃ©coche pour un produit qui n'a rien Ã  faire dans "PiÃ¨ces dÃ©tachÃ©es"
  // (ex: tÃ©lÃ©phone reconditionnÃ© entier) â€” reste visible via sa fiche directe et ses collections

  modelId String
  model   Model  @relation(fields: [modelId], references: [id])

  orderItems OrderItem[]
  reviews    ProductReview[]
  favorites  Favorite[]

  // Champs mis en cache pour affichage rapide (Ã©tiquettes produit, listes) sans recalculer Ã  chaque fois
  avgRating   Float? // ex: 4.8
  reviewCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modelId])
  @@index([pieceType])
  @@map("products")
}

// ---------- Avis produits (diffÃ©rents des avis Google/Facebook de l'entreprise) ----------

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String? // uuid Supabase Auth si laissÃ© par un client connectÃ©
  authorName String
  rating     Int // 1 Ã  5
  text       String?  @db.Text
  verified   Boolean  @default(false) // true = achat confirmÃ© (via l'historique de commandes)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@map("product_reviews")
}

// ---------- Commandes / e-commerce ----------

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  SUMUP
  PAYPAL
}

enum ShippingCarrier {
  CHRONOPOST
  COLISSIMO
  MONDIAL_RELAY
  RELAIS_COLIS
  AUTRE
}

model Order {
  id             String      @id @default(cuid())
  invoiceNumber  Int         @unique @default(autoincrement())
  userId         String? // uuid Supabase Auth (auth.users.id) si le client Ã©tait connectÃ© au moment de la commande
  customerName   String
  customerEmail  String
  customerPhone  String?
  companyName    String? // facultatif, saisi sur l'adresse de facturation
  shippingLine1  String
  shippingCity   String
  shippingZip    String

  // Adresse de facturation (peut diffÃ©rer de la livraison â€” choix gÃ©rÃ© nativement par Stripe Checkout)
  billingName    String?
  billingLine1   String?
  billingCity    String?
  billingZip     String?

  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  promoCode      String?
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  shippingCost   Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)

  paymentProvider PaymentProvider @default(STRIPE)
  stripeSessionId String?    @unique
  stripePaymentIntentId String?
  sumupCheckoutId String?    @unique
  paypalOrderId  String?     @unique

  // Mode de paiement (renseignÃ© automatiquement par le webhook aprÃ¨s paiement)
  paymentBrand   String? // ex: "visa", "mastercard"...
  paymentLast4   String?

  // Suivi de livraison
  carrier         ShippingCarrier?
  trackingNumber  String?
  trackingUrlOverride String?

  reminderSentAt DateTime? // derniÃ¨re relance email envoyÃ©e pour une commande restÃ©e "En attente"
  deliveredAt    DateTime? // date Ã  laquelle la commande est passÃ©e au statut "LivrÃ©e"
  reviewReminderSentAt DateTime? // relance "laisse un avis" dÃ©jÃ  envoyÃ©e pour cette commande

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

// ---------- Prise de RDV rÃ©paration ----------

enum AppointmentType {
  ATELIER
  DOMICILE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DONE
  CANCELLED
}

model Appointment {
  id              String            @id @default(cuid())
  userId          String? // uuid Supabase Auth (auth.users.id) si le client Ã©tait connectÃ© au moment de la demande
  customerName    String
  customerEmail   String
  customerPhone   String
  deviceBrand     String
  deviceModel     String
  issueDescription String           @db.Text
  type            AppointmentType   @default(ATELIER)
  city            String // pour calcul du supplÃ©ment zone
  extraFee        Decimal           @default(0) @db.Decimal(10, 2)
  preferredDate   DateTime
  status          AppointmentStatus @default(REQUESTED)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("appointments")
}

// ---------- Zones de livraison / dÃ©placement Ã  supplÃ©ment ----------
// Sainte-Maxime = zone de base (gratuit)
// Saint-Tropez, Grimaud, Cogolin, La Croix-Valmer, Gassin, Plan-de-la-Tour, Les Issambres = +30â‚¬

model ServiceZone {
  id        String  @id @default(cuid())
  cityName  String  @unique
  extraFee  Decimal @default(0) @db.Decimal(10, 2)

  @@map("service_zones")
}

// ---------- Formulaire de contact ----------

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  requestType String? // "Aide" / "Bug" / "Erreur" / "Demande directe" (widget flottant "Besoin d'aide ?")
  subject     String
  message     String   @db.Text
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ---------- Avis clients (gÃ©rÃ©s manuellement en admin, faute d'intÃ©gration API live) ----------

enum ReviewSource {
  GOOGLE
  FACEBOOK
}

model Review {
  id             String       @id @default(cuid())
  source         ReviewSource
  authorName     String
  authorPhotoUrl String? // photo de l'auteur (facultatif, sinon initiales gÃ©nÃ©rÃ©es)
  rating         Int? // 1-5, optionnel (Facebook n'a que "recommande" sans note chiffrÃ©e)
  text           String       @db.Text
  reviewDate     DateTime? // date rÃ©elle de l'avis, pour afficher "il y a X jours"
  verified       Boolean      @default(true)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())

  @@map("reviews")
}

// ---------- Partenaires & liens de rÃ©fÃ©rencement (page d'accueil, gÃ©rÃ©s en admin) ----------

model Partner {
  id       String  @id @default(cuid())
  name     String
  logoUrl  String?
  linkUrl  String
  order    Int     @default(0)

  @@map("partners")
}

model ReferralLink {
  id       String @id @default(cuid())
  label    String
  url      String
  order    Int    @default(0)

  @@map("referral_links")
}

// ---------- Frais de port / options de livraison (configurables en admin) ----------

model ShippingOption {
  id          String   @id @default(cuid())
  label       String
  description String? // ex: "Livraison en 24h"
  price       Decimal  @db.Decimal(10, 2)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("shipping_options")
}

// ---------- RÃ©glages divers (clÃ©/valeur), pour des petites infos Ã©ditables sans crÃ©er une table dÃ©diÃ©e ----------

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ---------- Redirections 301 (crucial aprÃ¨s une migration de site, pour ne pas perdre le rÃ©fÃ©rencement accumulÃ©) ----------

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique // ex: "/ancienne-url-woocommerce" (commence toujours par /)
  toPath     String // ex: "/produit/nouvelle-url"
  statusCode Int      @default(301)
  hits       Int      @default(0) // nombre de fois oÃ¹ la redirection a Ã©tÃ© utilisÃ©e
  createdAt  DateTime @default(now())

  @@map("redirects")
}

// ---------- Statistiques de visite (compteur page d'accueil + tableau de bord admin) ----------

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@map("page_views")
}

// ---------- Codes promo ----------

enum PromoType {
  PERCENT
  FIXED
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      PromoType
  value     Decimal   @db.Decimal(10, 2) // ex: 10 (%) si PERCENT, ou 5.00 (â‚¬) si FIXED
  active    Boolean   @default(true)
  expiresAt DateTime?
  maxUses   Int? // null = illimitÃ©
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("promo_codes")
}

// ---------- Pages de contenu Ã©ditables (Ã€ propos, Mentions lÃ©gales, CGV...) ----------

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique // ex: "a-propos", "mentions-legales", "cgv"...
  title       String
  contentHtml String   @db.Text
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

// ---------- Liens de menu personnalisÃ©s (header) ----------
// Les marques (Apple/Samsung/...) sont toujours gÃ©nÃ©rÃ©es automatiquement depuis le catalogue.
// Ces entrÃ©es viennent s'ajouter aprÃ¨s, dans l'ordre choisi (ex: "Prendre RDV", "Blog", "Promos"...).

model HeaderMenuItem {
  id          String   @id @default(cuid())
  label       String
  href        String
  order       Int      @default(0)
  openInNewTab Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("header_menu_items")
}

// ---------- Collections manuelles (ex: "Apple ReconditionnÃ©s") ----------
// Regroupe des MODÃˆLES choisis Ã  la main, indÃ©pendamment de leur marque/gamme d'origine.
// Utile pour des pages transversales du style "ReconditionnÃ©s", "Promo Ã©tÃ©", etc.
// Se lie ensuite Ã  une entrÃ©e du menu header via son URL /collection/[slug].

model Collection {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  productIds String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("collections")
}
// ---------- Favoris clients ----------
// Un produit peut Ãªtre mis en favori par un client connectÃ© (userId = uuid Supabase Auth).
// Contrainte unique (userId, productId) pour Ã©viter les doublons â€” le "toggle" gÃ¨re l'ajout/suppression.

model Favorite {
  id        String   @id @default(cuid())
  userId    String // uuid Supabase Auth (auth.users.id)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}
// ---------- Guides de réparation (blog type iFixit) ----------
// Un guide est optionnellement lié à un Model existant du catalogue (même table que les produits) :
// ça permet d'afficher automatiquement "Guides pour ce modèle" sur une fiche produit, sans avoir
// à faire de liaison manuelle produit <-> guide.

enum GuideDifficulty {
  FACILE
  MOYEN
  DIFFICILE
}

model RepairGuide {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  excerpt         String?         @db.Text // résumé affiché sur les cartes/listes
  coverImageUrl   String?

  modelId         String? // lien vers le modèle concerné (ex: "iPhone 14") — active la correspondance auto avec les produits
  model           Model?          @relation(fields: [modelId], references: [id])

  difficulty      GuideDifficulty @default(MOYEN)
  estimatedTime   String? // ex: "30-45 min"
  toolsNeeded     String[]        @default([]) // ex: ["Tournevis Pentalobe P2", "Ventouse"]
  partsNeeded     String[]        @default([]) // ex: ["Écran de remplacement iPhone 14"]

  published       Boolean         @default(true)
  viewCount       Int             @default(0)

  metaTitle       String?
  metaDescription String?         @db.Text

  steps           GuideStep[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([modelId])
  @@map("repair_guides")
}

model GuideStep {
  id          String      @id @default(cuid())
  guideId     String
  guide       RepairGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  contentHtml String      @db.Text
  imageUrl    String?
  warning     String?     @db.Text // avertissement optionnel affiché en encart rouge (ex: "Attention à la nappe")

  @@index([guideId])
  @@map("guide_steps")
}