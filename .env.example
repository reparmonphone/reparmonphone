# Base de données Supabase (Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase (front + admin)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxx"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# Divers
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Synchronisation avis Google (optionnel — voir README pour la config)
GOOGLE_PLACES_API_KEY="xxxx"
GOOGLE_PLACE_ID="xxxx"

# Remarque : NEXT_PUBLIC_SUPABASE_URL et NEXT_PUBLIC_SUPABASE_ANON_KEY (ci-dessus)
# servent aussi à l'authentification de l'admin (/admin). Aucune variable supplémentaire requise.
