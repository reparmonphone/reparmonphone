# Base de données Supabase (Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase (front + admin)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxx"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# SumUp (paiement alternatif) — clé API depuis me.sumup.com > Réglages > Pour les développeurs > Clés API
SUMUP_API_KEY="sup_sk_xxxx"
SUMUP_MERCHANT_CODE="MCXXXXXX"

# PayPal (paiement alternatif) — depuis developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID="xxxx"
PAYPAL_CLIENT_SECRET="xxxx"
PAYPAL_MODE="sandbox"

# Divers
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SEO — IndexNow (facultatif, une clé par défaut est déjà intégrée dans le code, adapte-la si tu veux la tienne)
INDEXNOW_KEY="84c3b0b5a3f8e46a71d3c3aaff7772e7"

# Synchronisation avis Google (optionnel — voir README pour la config)
GOOGLE_PLACES_API_KEY="xxxx"
GOOGLE_PLACE_ID="ChIJnZQG5pS4zhIR5GVZVSD1HQ8"

# Envoi d'emails (factures, confirmations) — optionnel, voir README
RESEND_API_KEY="xxxx"
RESEND_FROM_EMAIL="ReparMonPhone <contact@reparmonphone.fr>"

# Secret pour protéger la route de relance automatique des commandes en attente (voir README)
CRON_SECRET="choisis-une-longue-chaine-aleatoire"

# Remarque : NEXT_PUBLIC_SUPABASE_URL et NEXT_PUBLIC_SUPABASE_ANON_KEY (ci-dessus)
